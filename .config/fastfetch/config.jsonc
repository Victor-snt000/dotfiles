{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "blue",
      "output": "white"
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "arch // workstation"
    },
    {
      "type": "separator",
      "string": "----------------"
    },
    {
      "type": "os",
      "key": "distro"
    },
    {
      "type": "command",
      "key": "host",
      "text": "cat /sys/class/dmi/id/board_name"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "combined": true
    },
    {
      "type": "display",
      "key": "display"
    },
    {
      "type": "de",
      "key": "desktop"
    },
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "theme",
      "key": "theme"
    },
    {
      "type": "icons",
      "key": "icons"
    },
    {
      "type": "font",
      "key": "font"
    },
    {
      "type": "cursor",
      "key": "cursor"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "terminal",
      "key": "term"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "temp": false,
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "key": "gpu",
      "temp": false
    },
    {
      "type": "memory",
      "key": "mem"
    },
    {
      "type": "swap",
      "key": "swap"
    },
    {
      "type": "localip",
      "key": "ip",
      "showIpv4": true,
      "showIpv6": false
    },
    {
      "type": "disk",
      "key": "root",
      "folders": "/",
      "showExternal": false,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": false
    },
    {
      "type": "disk",
      "key": "home",
      "folders": "/home",
      "showExternal": false,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": false
    },
    {
      "type": "battery",
      "key": "battery"
    },
    {
      "type": "locale",
      "key": "locale"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
